#!/usr/bin/env python3
"""
Download YouTube video and transcribe with Whisper, then clean with Claude CLI.

Usage: yt-transcribe <youtube_url>
"""

import sys
import os
import tempfile
import subprocess
import re
from datetime import datetime
from pathlib import Path

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
PROCESS_SCRIPT = os.path.join(SCRIPT_DIR, "process-transcript.py")

# Load .env if exists
def load_env():
    env_file = Path(SCRIPT_DIR).parent / ".env"
    if env_file.exists():
        with open(env_file) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith('#') and '=' in line:
                    key, value = line.split('=', 1)
                    if key not in os.environ:
                        os.environ[key] = os.path.expanduser(value)

load_env()

# Obsidian paths (configurable via .env)
OBSIDIAN_VAULT = os.path.expanduser(os.environ.get("OBSIDIAN_VAULT", "~/Documents/Obsidian"))
OBSIDIAN_INBOX = os.path.expanduser(os.environ.get("OBSIDIAN_INBOX", os.path.join(OBSIDIAN_VAULT, "0 INBOX")))

def get_video_id(url):
    """Extract video ID from YouTube URL."""
    patterns = [
        r'(?:v=|/v/|youtu\.be/)([a-zA-Z0-9_-]{11})',
        r'^([a-zA-Z0-9_-]{11})$'
    ]
    for pattern in patterns:
        match = re.search(pattern, url)
        if match:
            return match.group(1)
    return None

def get_video_title(url):
    """Get video title using yt-dlp."""
    try:
        result = subprocess.run(
            ["yt-dlp", "--get-title", url],
            capture_output=True, text=True
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except Exception:
        pass
    return None

def slugify(text):
    """Convert text to a safe filename."""
    text = text.lower()
    text = re.sub(r'[^\w\s-]', '', text)
    text = re.sub(r'[-\s]+', '-', text)
    return text.strip('-')[:80]

def transcribe_with_whisper(url):
    """Download audio and transcribe with Whisper CLI."""
    with tempfile.TemporaryDirectory() as tmpdir:
        audio_path = os.path.join(tmpdir, "audio.mp3")

        print("Downloading audio...")
        result = subprocess.run([
            "yt-dlp", "-x", "--audio-format", "mp3", "-o", audio_path, url
        ], capture_output=True, text=True)

        if result.returncode != 0:
            print(f"Error downloading: {result.stderr}")
            sys.exit(1)

        # Find the actual audio file (yt-dlp may add extension)
        for f in os.listdir(tmpdir):
            if f.endswith('.mp3'):
                audio_path = os.path.join(tmpdir, f)
                break

        print("Transcribing with Whisper...")
        whisper_path = os.path.expanduser("~/.local/bin/whisper")
        result = subprocess.run([
            whisper_path, audio_path,
            "--model", "medium",
            "--language", "fr",
            "--output_format", "txt",
            "--output_dir", tmpdir
        ], capture_output=True, text=True)

        if result.returncode != 0:
            print(f"Error transcribing: {result.stderr}")
            sys.exit(1)

        # Read the output txt file
        txt_file = audio_path.rsplit('.', 1)[0] + '.txt'
        with open(txt_file, 'r') as f:
            return f.read().strip()

def clean_with_claude(transcript):
    """Clean transcript with Claude CLI."""
    print("Cleaning transcript with Claude...")

    try:
        result = subprocess.run(
            ["python3", PROCESS_SCRIPT],
            input=transcript,
            capture_output=True,
            text=True,
            timeout=300
        )

        if result.returncode != 0:
            print(f"Processing failed: {result.stderr}")
            return None

        return result.stdout.strip()

    except subprocess.TimeoutExpired:
        print("Processing timed out after 5 minutes")
        return None
    except Exception as e:
        print(f"Error processing transcript: {e}")
        return None

def main():
    if len(sys.argv) < 2:
        print("Usage: yt-transcribe <youtube_url>")
        sys.exit(1)

    url = sys.argv[1]

    video_id = get_video_id(url)
    if not video_id:
        print("Invalid YouTube URL")
        sys.exit(1)

    print(f"Processing video: {video_id}")

    # Get video title
    print("Fetching video title...")
    title = get_video_title(url) or video_id

    # Transcribe with Whisper
    transcript = transcribe_with_whisper(url)

    # Clean with Claude CLI
    cleaned = clean_with_claude(transcript)

    youtube_url = f"https://www.youtube.com/watch?v={video_id}"
    date_frontmatter = datetime.now().strftime("%d/%m/%Y")
    date_file = datetime.now().strftime("%Y-%m-%d")

    # Save to Obsidian INBOX
    os.makedirs(OBSIDIAN_INBOX, exist_ok=True)

    slug = slugify(title)
    filename = f"{date_file}-{slug}.md"
    output_path = os.path.join(OBSIDIAN_INBOX, filename)

    content = f"""---
MOC:
Source: {youtube_url}
Auteur:
Date: {date_frontmatter}
---

# {title}

{cleaned if cleaned else "Transcription non disponible"}
"""

    with open(output_path, 'w') as f:
        f.write(content)

    print(f"\nSaved to: {output_path}")

if __name__ == "__main__":
    main()
