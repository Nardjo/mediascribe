# Readwise Reader API token
# Get your token at https://readwise.io/access_token
READWISE_TOKEN=

# AI Provider: Claude Code CLI (utilisé par défaut)
# AI_PROVIDER=claude

# Media files directory (optional, defaults to ~/dwhelper)
MEDIA_DIR=~/dwhelper

# Obsidian vault path (optional, defaults to ~/Documents/Obsidian)
OBSIDIAN_VAULT=~/Documents/Obsidian

# Obsidian inbox path (optional, defaults to $OBSIDIAN_VAULT/0 INBOX)
OBSIDIAN_INBOX=~/Documents/Obsidian/0 INBOX
